{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/check.js": {
      "maxDuration": 30
    },
    "api/log.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/check?summary=1",
      "schedule": "30 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/apple",
      "destination": "https://www.apple.com/shop/retail/pickup-message?pl=true&location=37215&parts.0=MK1E4LL/A&parts.1=MK1F4LL/A",
      "permanent": false
    }
  ]
}
